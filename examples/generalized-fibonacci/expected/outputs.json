{
  "version": 1,
  "scene": "GeneralizedFibonacci",
  "beats": [
    "hook",
    "family",
    "data",
    "state-space",
    "roots",
    "edge-case",
    "recap"
  ],
  "deliverables": [
    {
      "path": "dist/GeneralizedFibonacci.mp4",
      "render": "manim-director render --profile production",
      "export": "manim-director export --format mp4 --profile production",
      "width": 1920,
      "height": 1080,
      "fps": 60,
      "alpha": false
    },
    {
      "path": "dist/GeneralizedFibonacci.webm",
      "render": "manim-director render --profile transparent",
      "export": "manim-director export --format webm --profile transparent",
      "width": 1920,
      "height": 1080,
      "fps": 60,
      "alpha": true
    },
    {
      "path": "dist/GeneralizedFibonacci.gif",
      "render": "manim-director render --profile loop-gif",
      "export": "manim-director export --format gif --profile loop-gif",
      "width": 640,
      "height": 360,
      "fps": 15,
      "alpha": false
    },
    {
      "path": "dist/generalized-fibonacci.zip",
      "render": "manim-director render --profile production",
      "export": "manim-director export"
    }
  ]
}
