{
  "name": "@manim-director/workbench",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "tsc --noEmit -p tsconfig.node.json && node --experimental-strip-types --test test/*.test.ts",
